{
  "name": "kion-music-scrobbler",
  "version": "2026.10",
  "private": true,
  "description": "Scrobble music.mts.ru to Last.fm",
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "icons": "node scripts/make-icons.mjs assets/icon-source.png",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "blueimp-md5": "^2.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/blueimp-md5": "^2.18.0",
    "@types/chrome": "^0.1.0",
    "daisyui": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0",
    "vitest": "^5.0.3",
    "wxt": "^0.20.0"
  }
}
